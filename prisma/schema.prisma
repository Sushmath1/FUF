generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  id            String              @id @default(cuid())
  name          String
  shortName     String?
  logoUrl       String?
  bannerUrl     String?
  mapImageUrl    String?
  mainGateLat   Float?
  mainGateLng   Float?
  contactName   String
  contactNumber String
  festName      String
  festTagline   String?
  festStartDate DateTime
  festEndDate   DateTime
  isActive      Boolean             @default(true)

  themeDescription String?
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  bgColor          String?
  surfaceColor     String?
  fontStyle        String?
  moodText         String?
  particleStyle    String?

  account        CollegeAccount?
  venues         Venue[]
  events         Event[]
  preRegistered  PreRegisteredEntry[]
  buildings      Building[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model CollegeAccount {
  id           String   @id @default(cuid())
  collegeId    String   @unique
  college      College  @relation(fields: [collegeId], references: [id])
  adminEmail   String   @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

model Building {
  id               String   @id @default(cuid())
  collegeId        String
  college          College  @relation(fields: [collegeId], references: [id])
  name             String
  shortName        String?
  lat              Float?
  lng              Float?
  floorPlanUrl     String?
  entranceXPercent Float?
  entranceYPercent Float?
  floors           Int      @default(1)
  venues           Venue[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Venue {
  id            String        @id @default(cuid())
  collegeId     String
  college       College       @relation(fields: [collegeId], references: [id])
  buildingId    String?
  building      Building?     @relation(fields: [buildingId], references: [id])
  name          String
  floor         Int?          @default(1)
  capacity      Int?
  xPercent      Float?
  yPercent      Float?
  lat           Float?
  lng           Float?
  directions    String?
  events        Event[]
  distancesFrom VenueDistance[] @relation("fromVenue")
  distancesTo   VenueDistance[] @relation("toVenue")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model VenueDistance {
  id          String @id @default(cuid())
  fromVenueId String
  toVenueId   String
  fromVenue   Venue  @relation("fromVenue", fields: [fromVenueId], references: [id])
  toVenue     Venue  @relation("toVenue", fields: [toVenueId], references: [id])
  walkMinutes Int
}

enum EventStatus {
  SCHEDULED
  CHANGED
  CANCELLED
  COMPLETED
}

enum EventCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  WORKSHOP
  GAMING
  MUSIC
  DANCE
  FOOD
  OTHER
}

model Event {
  id                String        @id @default(cuid())
  collegeId         String
  college           College       @relation(fields: [collegeId], references: [id])
  venueId           String
  venue             Venue         @relation(fields: [venueId], references: [id])
  name              String
  description       String?
  category          EventCategory @default(OTHER)
  startTime         DateTime
  endTime           DateTime
  status            EventStatus   @default(SCHEDULED)
  maxParticipants   Int?
  contactName       String?
  contactNumber     String?
  lastVenueChangeAt DateTime?
  previousVenueName String?
  registrations     Registration[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Visitor {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  account       VisitorAccount?
  registrations Registration[]
  createdAt     DateTime       @default(now())
}

model VisitorAccount {
  id           String   @id @default(cuid())
  visitorId    String   @unique
  visitor      Visitor  @relation(fields: [visitorId], references: [id])
  email        String   @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

model Registration {
  id             String   @id @default(cuid())
  visitorId      String?
  visitor        Visitor? @relation(fields: [visitorId], references: [id])
  guestSessionId String?
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id])
  collegeId      String
  registeredAt   DateTime @default(now())

  @@unique([visitorId, eventId])
  @@unique([guestSessionId, eventId])
}

model PreRegisteredEntry {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  eventId   String
  eventName String
  email     String?
  phone     String?
  matched   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([collegeId, email])
  @@index([collegeId, phone])
}